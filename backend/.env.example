# Copy to backend/.env and set your own values.
RO_ADMIN_USERNAME=admin
# Either a plain password (hashed in memory at startup) ...
RO_ADMIN_PASSWORD=change-me
# ... or, preferably, a bcrypt hash generated with:  python scripts/hash_password.py
# RO_ADMIN_PASSWORD_HASH=$2b$12$...
# Long random string used to sign session cookies (sessions survive restarts when set)
RO_SECRET_KEY=replace-with-a-long-random-string
RO_SESSION_HOURS=8
# Optional overrides
# RO_DATABASE_PATH=backend/data/ro_membrane.db
# RO_BACKUP_DIR=backend/backups
# RO_COOKIE_SECURE=false
# Optional AI explanation layer - disabled by default; never used for engineering decisions
RO_AI_EXPLANATIONS=false
